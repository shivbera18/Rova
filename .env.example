# Chalo-X Platform Root Environment Template
# Copy to services/core/.env for backend configuration.

# Backend Core API & WebSocket Gateway Port
PORT=8080

# Environment mode: development | production | test
NODE_ENV=development

# Explicit opt-in for development conveniences: the shared dev OTP (123456),
# /v1/dev/* endpoints, wallet top-up, and the devHint login hint.
# MUST stay unset/0 in any deployed environment — production refuses to serve them.
ENABLE_DEV_ENDPOINTS=1
# Local convenience only: services/core/.env should set the same flag for pnpm dev.

# Authentication & Quote Cryptography Secret (HMAC-SHA256 & JWT)
# Production: generate with `openssl rand -hex 32`
JWT_SECRET=dev-only-secret-rotate-in-production

# PostgreSQL Connection URL (Neon / docker compose / any Postgres 16)
# Leave commented out for zero-config embedded PGlite in development.
# Local docker:  postgres://chalo:chalo@localhost:5432/chalox
# Neon example:  postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# (TLS is enabled automatically for non-local hosts)
# DATABASE_URL=postgres://chalo:chalo@localhost:5432/chalox

# Embedded PGlite Data Directory (dev only)
PGLITE_DIR=.chalo-data

# CORS Allowed Origins
CORS_ORIGIN=*

# Web Push VAPID credentials. Generate once with: npx web-push generate-vapid-keys
# Production must keep these stable across deployments.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chalox.app
