# Chalo-X Core Backend Configuration Example
# Copy to services/core/.env for custom local or production overrides.

# Server listening port (default: 8080)
PORT=8080

# Environment: "development" | "production" | "test"
NODE_ENV=development

# 256-bit secret key used for JWT signing and HMAC quote tokens
# In production, generate with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-rotate-in-production

# PostgreSQL 16 connection string (optional in dev)
# Leave unset to use embedded zero-config WASM PostgreSQL (PGlite)
# DATABASE_URL=postgres://chalo:chalo@localhost:5432/chalox

# PGlite storage directory (when DATABASE_URL is unset)
# Set to ":memory:" for pure in-memory test mode, or a local directory path
PGLITE_DIR=.chalo-data

# Allowed CORS origins (comma-separated or * for dev)
CORS_ORIGIN=*
